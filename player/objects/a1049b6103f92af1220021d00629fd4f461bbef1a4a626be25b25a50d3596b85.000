<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#11130f">
  <meta name="description" content="HELLSCRIPT — 브라우저에서 플레이하는 액션 RPG / Play the action RPG in your browser.">
  <title>HELLSCRIPT · Web</title>
  <style>
    :root{color-scheme:dark;font-family:system-ui,sans-serif;background:#080a08;color:#e7dec5}
    *{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden}
    #game{position:fixed;inset:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left)}
    canvas{width:100%;height:100%;display:block;outline:none;touch-action:none}
    #loading{position:absolute;inset:0;display:grid;place-items:center;background:radial-gradient(ellipse at 50% 30%,#242719,#080a08 75%);padding:24px;overflow:auto}
    #loading[hidden]{display:none}.panel{max-width:480px;text-align:center}
    h1{font-family:Georgia,serif;letter-spacing:.12em;font-size:clamp(30px,7vw,48px);font-weight:400;margin:24px 0 10px}
    .edition{color:#bba575;font-size:12px;letter-spacing:.25em}p{font-size:14px;line-height:1.65;color:#c2bea9}
    progress{width:100%;height:7px;accent-color:#bca370;margin:14px 0}
    button{border:1px solid #9e8859;background:#22271b;color:#eee4cc;font:inherit;padding:12px 20px;cursor:pointer}
    button:focus-visible{outline:2px solid #e7cf97;outline-offset:3px}button:disabled{opacity:.45;cursor:wait}
    #start{min-width:200px;margin:12px 0}#language{font-size:12px;padding:7px 12px;background:transparent}
    #status{min-height:24px}#error{color:#f0b1a4;white-space:pre-wrap;overflow-wrap:anywhere}
    .small{font-size:12px;color:#a2a48e}.actions{display:flex;justify-content:center;gap:10px;align-items:center}
  </style>
</head>
<body>
<main id="game">
  <canvas id="unity-canvas" width="1280" height="720" tabindex="0" aria-label="HELLSCRIPT"></canvas>
  <section id="loading" aria-label="HELLSCRIPT loading">
    <div class="panel">
      <div class="edition">BROWSER EDITION</div><h1>HELLSCRIPT</h1>
      <p id="intro"></p><p id="save-note" class="small"></p>
      <progress id="progress" max="1" value="0" aria-label="Loading"></progress>
      <p id="status" role="status" aria-live="polite"></p><p id="error" role="alert" hidden></p>
      <div class="actions"><button id="start" disabled></button><button id="language" type="button">English</button></div>
      <p id="background-note" class="small"></p>
      <noscript>JavaScript를 켜야 플레이할 수 있습니다. Enable JavaScript to play.</noscript>
    </div>
  </section>
</main>
<script>
'use strict';
const text={
  ko:{intro:'잿빛 성소에서 다시 깨어나세요.',save:'진행 상황은 현재 브라우저에 저장됩니다. 브라우저 데이터를 지우면 저장도 삭제됩니다.',loading:'게임을 불러오고 있습니다…',ready:'준비되었습니다.',start:'게임 시작',background:'다른 탭으로 이동하거나 창을 닫으면 사냥이 중단됩니다.',error:'게임을 불러오지 못했습니다. 연결 상태를 확인하고 새로고침해 주세요.',storage:'브라우저 저장 공간을 사용할 수 없습니다. 비공개 모드를 해제하거나 이 사이트의 저장을 허용한 뒤 다시 열어 주세요.',duplicate:'다른 탭에서 게임이 열려 있습니다. 먼저 그 탭을 닫은 뒤 새로고침해 주세요.'},
  en:{intro:'Awaken again in the ashen sanctuary.',save:'Progress is saved in this browser. Clearing browser data also deletes your save.',loading:'Loading the game…',ready:'Ready to play.',start:'Start game',background:'Hunting pauses when you switch tabs or close this window.',error:'The game could not load. Check your connection and reload.',storage:'Browser storage is unavailable. Allow site storage or leave private browsing and try again.',duplicate:'The game is open in another tab. Close that tab, then reload this page.'}
};
let language=navigator.language.startsWith('ko')?'ko':'en',instance=null,state='loading',failure='';
const canvas=document.getElementById('unity-canvas'),start=document.getElementById('start'),progress=document.getElementById('progress');
function render(){const t=text[language];document.documentElement.lang=language;document.getElementById('intro').textContent=t.intro;document.getElementById('save-note').textContent=t.save;document.getElementById('background-note').textContent=t.background;document.getElementById('status').textContent=t[state]||'';start.textContent=t.start;document.getElementById('language').textContent=language==='ko'?'English':'한국어';const error=document.getElementById('error');error.hidden=!failure;error.textContent=failure?t[failure]||t.error:'';}
function fail(kind,error){failure=kind;state='';start.disabled=true;render();console.error('HELLSCRIPT_WEB_LOAD',error||kind);}
function visibility(){if(instance)instance.SendMessage('HELLSCRIPT','WebVisibilityChanged',document.hidden?'1':'0');}
document.addEventListener('visibilitychange',visibility);
window.addEventListener('pagehide',()=>{if(instance)instance.SendMessage('HELLSCRIPT','WebVisibilityChanged','1');});
document.getElementById('language').addEventListener('click',()=>{language=language==='ko'?'en':'ko';render();});
start.addEventListener('click',()=>{document.getElementById('loading').hidden=true;canvas.focus();});
async function checkStorage(){return new Promise((resolve,reject)=>{const request=indexedDB.open('hellscript-storage-check',1);request.onerror=()=>reject(request.error);request.onsuccess=()=>{request.result.close();resolve();};});}
async function load(){
  try{await checkStorage();}catch(error){fail('storage',error);return;}
  const config={
    arguments:[],
    dataUrl:'Build/7f47c68529b2f2087696bd6e6cde0ef7.data.unityweb',
    frameworkUrl:'Build/dd0f610a8c5f517a337ee28f4ee802d7.framework.js.unityweb',
    codeUrl:'Build/43fba4ad99361135b7fcf4428f8846cc.wasm.unityweb',
    streamingAssetsUrl:'StreamingAssets',
    companyName:"DefaultCompany",
    productName:"HELLSCRIPT",
    productVersion:"0.1.0",
    autoSyncPersistentDataPath:true,
    devicePixelRatio:Math.min(window.devicePixelRatio||1,1.5),
    showBanner:(message,type)=>{if(type==='error')fail('error',message);else console.warn(message);}
  };
  const script=document.createElement('script');script.src='Build/a1eb995945143e5b9ba886e2f6b6d7f1.loader.js';
  script.onerror=()=>fail('error','loader unavailable');
  script.onload=async()=>{try{instance=await createUnityInstance(canvas,config,value=>{progress.value=value;});state='ready';progress.value=1;start.disabled=false;render();}catch(error){fail('error',error);}};
  document.body.appendChild(script);
}
render();
if(navigator.locks){navigator.locks.request('hellscript:'+location.pathname.replace(/index\.html$/,''),{ifAvailable:true},async lock=>{if(!lock){fail('duplicate');return;}await load();await new Promise(()=>{});}).catch(error=>fail('error',error));}
else load();
</script>
</body>
</html>
